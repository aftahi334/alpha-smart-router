%% file: docs/diagrams/architecture.mmd
%% Mermaid v10+ compatible, safe for mmdc

flowchart LR

%% ================== CLUSTERS ==================
    subgraph Ingress["Ingress / Egress Interfaces"]
        NIC["RX Producer / Traffic Gen"]
        EGRESS["Simulated TX / Egress"]
    end

    subgraph Mem["alpha::mem — Preallocated Primitives"]
        direction TB
        POOL["PacketPool<br/>(fixed-capacity, preallocated)"]
        SPSC["SpscQueue&lt;PacketHandle&gt;<br/>(lock-free ring, construct_at/destroy_at)"]
    end

    subgraph DP["alpha::routing — Data Plane Fast Path"]
        direction TB
        SEL["IngressSelector<br/>(RR / HashSourceIP / Hash5Tuple / BGP)"]
        PB["PolicyBinding + MetricsSlot<br/>(lock-free seqlock snapshots)"]
        PS["Path Selection<br/>(RoundRobin / FlowHash / LatencyAware)"]
    end

    subgraph CP["alpha::routing — Control Plane (Single Writer)"]
        direction TB
        SRV["ServiceRegistry<br/>(RCU atomic shared_ptr Map)"]
        QoS["QoSPolicy<br/>(QoSPathMetrics → to_dp_metrics)"]
        FAIL["FailoverPolicy<br/>(min_hold_ms &amp; recovery_hold_ms)"]
        BGPSIM["SimulatedBgpOracle<br/>(LP / AS-Path / MED / IGP)"]
    end

    subgraph Obs["alpha::obs &amp; alpha::rt"]
        OBS["Observability<br/>(counters, decisions, drops)"]
        RT["OS Runtime<br/>(mlockall, CPU affinity, SCHED_FIFO)"]
    end

%% ================== DATA PLANE HOT PATH ==================
    NIC -->|"1. acquire() PacketHandle"| POOL
    NIC -->|"2. chooseIngress()"| SEL
    SEL -->|"3. push(PacketHandle)"| SPSC
    SPSC -->|"4. pop(PacketHandle)"| PS
    PB -->|"seqlock read"| PS
    PS -->|"5. RouteDecision (SelectedHealthy / DegradedFallback)"| EGRESS
    EGRESS -->|"6. release(PacketHandle)"| POOL

%% ================== CONTROL PLANE PUBLICATIONS ==================
    SRV -. "RCU snapshot (PopList)" .-> SEL
    BGPSIM -. "serving_pop()" .-> SEL
    QoS -. "cp::update_metrics()" .-> PB
    FAIL -. "cp::publish_policy()" .-> PB

%% ================== OBSERVABILITY & RUNTIME ==================
    SEL -. "counters" .-> OBS
    PS  -. "SelectReason" .-> OBS
    FAIL -. "FailoverDecision" .-> OBS
    RT -. "pin &amp; lock" .-> NIC
    RT -. "pin &amp; lock" .-> PS

